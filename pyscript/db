button_card_templates:
  sprinkler_qe_row:
    show_icon: false
    show_state: false
    show_label: true
    name: |
      [[[
        return states[`sensor.sprinkler_qe_${variables.slot}_name`]?.state || 'Queue-Entry ${variables.slot}';
      ]]]
    label: |
      [[[
        return "Laufzeit: " + (states[`sensor.sprinkler_qe_${variables.slot}_remaining_time`]?.state || '00:00:00');
      ]]]
    tap_action:
      action: fire-dom-event
      browser_mod:
        service: browser_mod.popup
        data:
          title: Laufzeit einstellen
          content:
            type: vertical-stack
            cards:
              - type: entities
                entities:
                  - input_text.sprinkler_entry_duration
              - type: button
                name: Übernehmen
                icon: mdi:check
                tap_action:
                  action: fire-dom-event
                  browser_mod:
                    service: browser_mod.sequence
                    data:
                      sequence:
                        - service: pyscript.sprinkler_set_qe_duration
                          data:
                            qe_id: |
                              [[[
                                return Number(
                                  states[`sensor.sprinkler_qe_${variables.slot}_qe_id`]?.state
                                );
                              ]]]
                        - service: browser_mod.close_popup
    layout: grid
    styles:
      grid:
        - grid-template-columns: 1fr auto
        - grid-template-rows: auto auto
        - grid-template-areas: |
            "n b"
            "l b"
      card:
        - padding: 12px
        - border-radius: 12px
      name:
        - font-size: 16px
        - font-weight: 600
      label:
        - font-size: 14px
        - opacity: 0.8
    custom_fields:
      b:
        card:
          type: custom:button-card
          show_name: false
          show_state: false
          size: 36px
          icon: |
            [[[
              const s = states[`sensor.sprinkler_qe_${variables.slot}_status`]?.state;
              return (s === 'off')
                ? 'mdi:play-circle-outline'
                : 'mdi:stop-circle-outline';
            ]]]
          styles:
            card:
              - box-shadow: none
              - padding: 0
            icon:
              - color: |
                  [[[
                    const s = states[`sensor.sprinkler_qe_${variables.slot}_status`]?.state;
                    if (s === 'running') return '#e53935';
                    if (s === 'queued' || s === 'enqueue') return '#fb8c00';
                    return '#9e9e9e';
                  ]]]
          tap_action:
            action: |
              [[[
                const s = states[`sensor.sprinkler_qe_${variables.slot}_status`]?.state;
                return (s === 'off')
                  ? 'call-service'
                  : 'fire-dom-event';
              ]]]
            service: pyscript.sprinkler_enqueue_qe
            service_data:
              qe_id: |
                [[[
                  return Number(
                    states[`sensor.sprinkler_qe_${variables.slot}_qe_id`]?.state
                  );
                ]]]
            browser_mod:
              service: browser_mod.popup
              data:
                title: Zone stoppen?
                dismissable: false
                content:
                  type: vertical-stack
                  cards:
                    - type: horizontal-stack
                      cards:
                        - type: button
                          name: Ja
                          tap_action:
                            action: fire-dom-event
                            browser_mod:
                              service: browser_mod.sequence
                              data:
                                sequence:
                                  - service: pyscript.sprinkler_cancel_qe
                                    data:
                                      qe_id: |
                                        [[[
                                          return Number(
                                            states[`sensor.sprinkler_qe_${variables.slot}_qe_id`]?.state
                                          );
                                        ]]]
                                  - service: browser_mod.close_popup
                        - type: button
                          name: Nein
                          tap_action:
                            action: fire-dom-event
                            browser_mod:
                              service: browser_mod.close_popup
title: Sprinkler
